!example.tfvars

override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Helm: packaged charts and pulled dependencies
*.tgz
app/chart/charts/

# Python
.venv/
__pycache__/
*.py[cod]

# macOS
.DS_Store

# local vars for testing
local.auto.tfvars